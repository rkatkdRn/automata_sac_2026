# Vercel: set these directly in Settings > Environment Variables.
# Local execution: use the scripts/start-local.ps1 or OS environment variables.
# Never upload a real .env file, database, or backup.
ADMIN_PIN=
DATABASE_URL=
PUBLIC_BASE_URL=
PRIVACY_CONTACT=Automata 부스 운영진
# Used only when DATABASE_URL is empty AND VERCEL is not set.
DB_PATH=data/dev.db
# Backup tools use this direct, non-pooler URL when PostgreSQL is used.
DATABASE_URL_UNPOOLED=
