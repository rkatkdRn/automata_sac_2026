{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "regions": ["hnd1"],
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "includeFiles": "server/**",
      "excludeFiles": "{tests/**,docs/**,scripts/**,backup/**,data/**,.venv/**,.pytest_cache/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    {"source": "/", "destination": "/index.html"},
    {"source": "/play", "destination": "/index.html"},
    {"source": "/result", "destination": "/index.html"},
    {"source": "/closed", "destination": "/index.html"},
    {"source": "/board", "destination": "/index.html"},
    {"source": "/hall", "destination": "/index.html"},
    {"source": "/admin", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "same-origin"},
      {"key": "X-Frame-Options", "value": "DENY"}
    ]},
    {"source": "/api/(.*)", "headers": [
      {"key": "Cache-Control", "value": "no-store, private"}
    ]}
  ]
}
